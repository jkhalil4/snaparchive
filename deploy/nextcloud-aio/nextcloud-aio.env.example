# Copy to ~/.config/snaparchive/nextcloud-aio.env

# Host folder containing memories/, _inbox/, _exports/ and .snaparchive/
ARCHIVE_ROOT=/mnt/storage/SnapArchive

# Nextcloud user, and ARCHIVE_ROOT's path in their files (no leading slash)
NC_USER=alice
NC_ARCHIVE_PATH=External/SnapArchive

NC_CONTAINER=nextcloud-aio-nextcloud
IMAGE=snaparchive:latest

# www-data in the Nextcloud image
RUN_AS=33:0

# Seconds the inbox must be unchanged before an import starts
MIN_AGE=600

# 1 = send a Nextcloud notification after each import
NOTIFY=1

# Extra flags for `snaparchive inbox`, e.g. "--workers 1"
EXTRA_ARGS=
