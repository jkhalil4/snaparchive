# Copy to ~/.config/snaparchive/nextcloud-aio.env and adjust.

# Host folder that holds memories/ (the archive), _inbox/, _exports/ and .snaparchive/.
# It must be visible to Nextcloud, e.g. through NEXTCLOUD_MOUNT + a "Local" external storage.
ARCHIVE_ROOT=/mnt/storage/SnapArchive

# Nextcloud user, and where ARCHIVE_ROOT appears in that user's files
# (the path you see in the web UI, without a leading slash).
NC_USER=alice
NC_ARCHIVE_PATH=External/SnapArchive

NC_CONTAINER=nextcloud-aio-nextcloud
IMAGE=snaparchive:latest

# uid:gid the importer runs as; 33 is www-data in the Nextcloud image.
RUN_AS=33:0

# Seconds the inbox must sit untouched before an import starts (lets multi-part uploads finish).
MIN_AGE=600

# 1 = send a Nextcloud notification when an import finishes.
NOTIFY=1

# Extra flags for `snaparchive inbox`, e.g. "--workers 1 --preset slow".
EXTRA_ARGS=
